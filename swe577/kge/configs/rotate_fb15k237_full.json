{
  "name": "rotate_fb15k237_full",
  "dataset": "FB15k237",
  "model": "RotatE",
  "model_kwargs": { "embedding_dim": 1000 },
  "loss": "NSSALoss",
  "loss_kwargs": { "margin": 9.0, "adversarial_temperature": 1.0 },
  "optimizer": "Adam",
  "optimizer_kwargs": { "lr": 0.00005 },
  "negative_sampler": "basic",
  "negative_sampler_kwargs": { "num_negs_per_pos": 256 },
  "training_kwargs": { "num_epochs": 1000, "batch_size": 1024 },
  "seed": 42,
  "_notes": "Paper-faithful config from Sun et al. 2019 (Table 5). GPU required; full training takes 10+ hours on a single modern GPU."
}
