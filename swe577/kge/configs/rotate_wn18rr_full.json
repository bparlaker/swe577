{
  "name": "rotate_wn18rr_full",
  "dataset": "WN18RR",
  "model": "RotatE",
  "model_kwargs": { "embedding_dim": 500 },
  "loss": "NSSALoss",
  "loss_kwargs": { "margin": 6.0, "adversarial_temperature": 0.5 },
  "optimizer": "Adam",
  "optimizer_kwargs": { "lr": 0.00005 },
  "negative_sampler": "basic",
  "negative_sampler_kwargs": { "num_negs_per_pos": 1024 },
  "training_kwargs": { "num_epochs": 1000, "batch_size": 512 },
  "seed": 42,
  "_notes": "Paper-faithful config from Sun et al. 2019 (Table 5) for WN18RR. GPU required."
}
