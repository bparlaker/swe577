{
  "name": "transe_wn18rr_full",
  "dataset": "WN18RR",
  "model": "TransE",
  "model_kwargs": { "embedding_dim": 500, "scoring_fct_norm": 1 },
  "loss": "MarginRankingLoss",
  "loss_kwargs": { "margin": 6.0 },
