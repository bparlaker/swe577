{
  "name": "rotate_wn18rr_small",
  "dataset": "WN18RR",
  "model": "RotatE",
  "model_kwargs": { "embedding_dim": 200 },
  "loss": "NSSALoss",
  "loss_kwargs": { "margin": 6.0, "adversarial_temperature": 0.5 },
  "optimizer": "Adam",
  "optimizer_kwargs": { "lr": 0.00005 },
  "negative_sampler": "basic",
  "negative_sampler_kwargs": { "num_negs_per_pos": 32 },
  "training_kwargs": { "num_epochs": 80, "batch_size": 512 },
  "seed": 42,
  "force_cpu": true,
  "_notes": "Reduced-scale RotatE for WN18RR. ~15-25 min on CPU."
}
